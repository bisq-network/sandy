--- !tapi-tbd
# The standard library of Rust links libiconv, from which sandy uses no symbol. Apple's linker keeps
# the library in the binary all the same, so this does too.
tbd-version:     4
targets:         [ x86_64-macos, arm64-macos ]
install-name:    '/usr/lib/libiconv.2.dylib'
current-version: 7
compatibility-version: 7
...
